# 编译器配置
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -pedantic
LDFLAGS = -lfl

# 目标文件
TARGETS = lexer lex
SRCS = lexer.cpp lex.cpp
OBJS = $(SRCS:.cpp=.o)

# 默认构建目标
all: $(TARGETS)

# 构建 lexer
lexer: lexer.o
	$(CXX) $(CXXFLAGS) -o $@ $<

# 构建 lex
lex: lex.o
	$(CXX) $(CXXFLAGS) -o $@ $< $(LDFLAGS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGETS)

.PHONY: all clean