# 编译器配置
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -pedantic
LDFLAGS = -lfl

TARGETS = lexer lex
SRCS = lexer.cpp lex.cpp
OBJS = $(SRCS:.cpp=.o)

all: $(TARGETS)

lexer: lexer.o
	$(CXX) $(CXXFLAGS) -o $@ $<

lex: lex.o
	$(CXX) $(CXXFLAGS) -o $@ $< $(LDFLAGS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGETS)

.PHONY: all clean