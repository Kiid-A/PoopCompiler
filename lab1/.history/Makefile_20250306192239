# 编译器配置
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -pedantic
LDFLAGS = -lfl

# 目标文件
TARGETS = lexer lex
SRCS = lexer.cpp lex.cpp
OBJS = $(SRCS:.cpp=.o)

# 默认构建目标
all: $(TARGETS)

# 构建 lexer
lexer: lexer.o
	$(CXX) $(CXXFLAGS) -o $@ $<

# 构建 lex
lex: lex.o
	$(CXX) $(CXXFLAGS) -o $@ $< $(LDFLAGS)

# 编译源文件生成目标文件
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# 清理生成的文件
clean:
	rm -f $(OBJS) $(TARGETS)

# 伪目标声明
.PHONY: all clean